{
  "expo": {
    "name": "NutriLife_app",
    "slug": "NutriLife_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8f5ec"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kazuki.nutrilife.app",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [
          "health-records"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "歩数データを取得して、アプリ内の活動ログを表示するために使用します。",
        "NSHealthUpdateUsageDescription": "アプリで測定したデータをヘルスケアに保存するために使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.kazuki.nutrilife.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "食事の写真を撮影するためにカメラを使用します。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "食事の写真を選択するためにフォトライブラリにアクセスします。"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a5c3a"
        }
      ],
      "@sentry/react-native/expo"
    ],
    "extra": {
      "eas": {
        "projectId": "c55d20c5-1d5e-44dd-8169-0e62a8e0dd57"
      }
    },
    "owner": "kazuki.yamada"
  }
}
